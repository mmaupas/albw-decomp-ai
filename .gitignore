# game data and the compiler are never committed: supply your own
code.bin
*.bin
tools/armcc/
# pinned third-party tool binaries (tools/setup_objdiff.py downloads these
# manually, SHA-256 verified; never committed, never fetched at build time)
tools/bin/
# build and check outputs
*.o
check_log.jsonl
__pycache__/
*.pyc
# uv-managed virtual environment
.venv/
# local secrets, never committed
.env*
# generated automation state (regenerable: dna.py index / ghidra_dump.py / synth.py / triage.py)
logs/dna.jsonl
logs/dna_build.log
logs/pseudocode/
logs/synth/
logs/triage/
logs/refine/
logs/refine_acceptance*.log
logs/autodecomp/
# merge cleanup: logs and backups never committed
logs/
*.bak
